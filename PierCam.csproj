<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PierCam</AssemblyName>
    <RootNamespace>PierCam</RootNamespace>
    <Product>PierCam</Product>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>

    <!-- The ASI SDK is 64-bit only. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF resolves specific cultures while laying out text; InvariantGlobalization makes that
         throw ("Cannot find non-neutral culture related to 'en-us'") and the window never opens. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Workstation, concurrent GC: this process runs for weeks and should give memory back
         rather than hold a large heap the way a server-GC process does. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <!-- Regenerate with scratchpad\make-icon.ps1 if the accent colour ever changes. -->
    <ApplicationIcon>piercam.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bright stars for the target marker's automatic calibration (44 KB, loaded only while calibrating). -->
    <EmbeddedResource Include="Sky\bright-stars.csv" LogicalName="PierCam.Sky.bright-stars.csv" />
  </ItemGroup>

  <ItemGroup>
    <!-- ffmpeg ships beside the exe; the encoder also falls back to PATH.

         ExcludeFromSingleFile matters more than it looks. A single-file publish otherwise
         bundles this into PierCam.exe *as well as* copying it alongside, so every download
         carried ffmpeg twice and the extra copy could never be run - the app launches
         tools\ffmpeg.exe as a process, which has to be a real file on disk. It cost about
         100 MB of the executable. -->
    <None Include="tools\ffmpeg.exe" Condition="Exists('tools\ffmpeg.exe')">
      <Link>tools\ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
