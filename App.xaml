<Application x:Class="PierCam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0 is the palette; ThemeManager swaps it at runtime.
                     Slot 1 is the control language, which only ever refers to slot 0
                     through DynamicResource. -->
                <ResourceDictionary Source="Ui/Theme/Dark.xaml"/>
                <ResourceDictionary Source="Ui/Theme/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
