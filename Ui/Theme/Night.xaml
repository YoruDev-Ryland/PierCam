<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════════════
         THEME: NIGHT — dark adaptation

         Deep red only, and dim. Rod cells are barely sensitive above ~620nm, so a
         screen restricted to red does not undo the twenty minutes your eyes spent
         adapting to the dark. Nothing here is allowed to go bright or neutral:
         even "signal" and "warn" stay inside the red band, distinguished by
         brightness rather than hue.
         ══════════════════════════════════════════════════════════════════════════ -->

    <sys:String x:Key="ThemeName">Night</sys:String>
    <sys:String x:Key="ThemeBlurb">Red only — preserves dark adaptation</sys:String>
    <sys:Boolean x:Key="ThemeIsLight">False</sys:Boolean>

    <!-- ── Surfaces ─────────────────────────────────────────────────────────── -->
    <Color x:Key="BgDeepColor">#FF030000</Color>
    <Color x:Key="BgColor">#FF070101</Color>
    <Color x:Key="PanelColor">#FF160404</Color>
    <Color x:Key="PanelRaisedColor">#FF200707</Color>

    <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelRaised" Color="{StaticResource PanelRaisedColor}"/>

    <SolidColorBrush x:Key="Glass" Color="#FF160404" Opacity="0.78"/>
    <SolidColorBrush x:Key="GlassDeep" Color="#FF070101" Opacity="0.90"/>
    <SolidColorBrush x:Key="Scrim" Color="#FF000000" Opacity="0.65"/>

    <!-- ── Lines ────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Hairline" Color="#FF3E0F0F"/>
    <SolidColorBrush x:Key="HairlineSoft" Color="#FF260909"/>
    <SolidColorBrush x:Key="HairlineStrong" Color="#FF5E1818"/>
    <SolidColorBrush x:Key="Grid" Color="#FF1E0606"/>

    <!-- ── Type ─────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Text" Color="#FFD84A4A"/>
    <SolidColorBrush x:Key="TextDim" Color="#FF953232"/>
    <SolidColorBrush x:Key="TextFaint" Color="#FF5E2020"/>
    <SolidColorBrush x:Key="TextInverse" Color="#FF070101"/>

    <!-- ── Signal colours ───────────────────────────────────────────────────── -->
    <Color x:Key="AccentColor">#FFCC3030</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#40CC3030"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FF0A0000"/>

    <SolidColorBrush x:Key="Signal" Color="#FFB04444"/>
    <SolidColorBrush x:Key="SignalSoft" Color="#33B04444"/>
    <SolidColorBrush x:Key="Warn" Color="#FFE05A2A"/>
    <SolidColorBrush x:Key="Danger" Color="#FFFF4040"/>

    <!-- ── Filled buttons ───────────────────────────────────────────────────────
         A mid red is the worst possible background for text: nothing reads on it,
         dark or light. The other palettes solve that by filling bright and writing
         in near-black, but going brighter is the wrong direction here. So the big
         buttons invert instead — near-black plate, bright red rule and lettering.
         Same emphasis, more contrast, and less light thrown at your eyes. -->
    <SolidColorBrush x:Key="PrimaryFill" Color="#FF3A0B0B"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFF7B7B"/>
    <SolidColorBrush x:Key="DangerFill" Color="#FF4E0F0F"/>
    <SolidColorBrush x:Key="OnDanger" Color="#FFFF9090"/>

    <!-- ── Geometry & effect constants ──────────────────────────────────────── -->
    <sys:Double x:Key="Chamfer">12</sys:Double>
    <sys:Double x:Key="ChamferSmall">7</sys:Double>
    <sys:Double x:Key="Hairline1">1</sys:Double>
    <sys:Double x:Key="NoiseOpacity">0.04</sys:Double>
    <sys:Double x:Key="VignetteOpacity">0.7</sys:Double>

    <!-- ── Type ramp ────────────────────────────────────────────────────────── -->
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>

</ResourceDictionary>
