<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:PierCam.Ui.Controls">

    <!-- Every brush/metric below comes from the palette dictionary merged ahead of this
         file, always via DynamicResource so a theme swap repaints without a reload. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ═══════════════ Type ═══════════════ -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Small caps-ish label: the ubiquitous technical annotation. -->
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
    </Style>

    <Style x:Key="LabelDim" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
    </Style>

    <!-- A line of text that opens something. Accent-coloured rather than the web's blue, and it
         underlines only under the pointer, so it reads as part of the instrument panel until you
         reach for it. -->
    <Style x:Key="LinkText" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Drop this into a ContentPresenter's Resources so the TextBlock it generates for string
         content follows the TextElement.Foreground set on that presenter.

         Without it the global implicit TextBlock style above wins — a style setter beats an
         inherited value — and a control's Foreground silently does nothing to its own label. That
         is why a filled button's text came out in the page's text colour instead of the colour
         chosen to sit on the fill, and why it looked right in the dark palettes purely by luck.
         Reading the presenter's value rather than the control's keeps template triggers working,
         since they set it on the presenter. -->
    <Style x:Key="PresentedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground"
                Value="{Binding Path=(TextElement.Foreground),
                        RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
    </Style>

    <Style x:Key="Readout" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
    </Style>

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ═══════════════ Panels ═══════════════ -->

    <Style TargetType="c:ChamferPanel">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Stroke" Value="{DynamicResource Hairline}"/>
        <Setter Property="StrokeThickness" Value="{DynamicResource Hairline1}"/>
        <Setter Property="Chamfer" Value="{DynamicResource Chamfer}"/>
        <Setter Property="Corners" Value="Diagonal"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ChamferPanel">
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Frosted variant: translucent fill + grain + top sheen. No live blur, deliberately —
         see Grain for why a texture beats a per-frame blur here. -->
    <!-- NOTE: style keys must never collide with palette keys. This dictionary is merged after
         the palette, so a Style keyed "Glass" would shadow the "Glass" brush and every
         DynamicResource lookup for it would resolve to a Style — hence the -Panel suffix. -->
    <!-- Frosted variant. Flat translucent fill plus a fine grain — deliberately no sheen
         gradient: the look is machined panel, not polished glass, so surfaces stay flat and
         the edges do the work. -->
    <Style x:Key="GlassPanel" TargetType="c:ChamferPanel" BasedOn="{StaticResource {x:Type c:ChamferPanel}}">
        <Setter Property="Background" Value="{DynamicResource Glass}"/>
        <!-- GrainBrush is the single shared noise tile, published by App at startup. -->
        <Setter Property="Grain" Value="{DynamicResource GrainBrush}"/>
        <Setter Property="GrainOpacity" Value="{DynamicResource NoiseOpacity}"/>
    </Style>

    <Style x:Key="GlassDeepPanel" TargetType="c:ChamferPanel" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="Background" Value="{DynamicResource GlassDeep}"/>
    </Style>

    <!-- Square panel for units that butt against a neighbour. -->
    <Style x:Key="Flush" TargetType="c:ChamferPanel" BasedOn="{StaticResource {x:Type c:ChamferPanel}}">
        <Setter Property="Corners" Value="None"/>
    </Style>

    <!-- ═══════════════ Plate assembly ═══════════════

         Plates in an assembly share edges. Each one is square everywhere except where it sits
         on the outside of the whole group, so a grid of them reads as one machined panel rather
         than a tray of separate boxes. The corner flags are set per plate at the call site,
         because only the layout knows which edges are exposed. -->

    <Style x:Key="Plate" TargetType="c:ChamferPanel" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="Corners" Value="None"/>
        <Setter Property="Chamfer" Value="18"/>
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- A plate that carries emphasis: accent edge, slightly lifted fill. -->
    <Style x:Key="PlateAccent" TargetType="c:ChamferPanel" BasedOn="{StaticResource Plate}">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="Stroke" Value="{DynamicResource HairlineStrong}"/>
    </Style>

    <!-- The stencilled index that sits in a plate's notch. -->
    <Style x:Key="PlateTag" TargetType="c:ChamferPanel">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Stroke" Value="{x:Null}"/>
        <Setter Property="Chamfer" Value="7"/>
        <Setter Property="Corners" Value="BottomLeft,BottomRight"/>
        <Setter Property="Padding" Value="11,3"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ChamferPanel">
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlateTagText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Heading row inside a plate: title on the left, small stencil code on the right. -->
    <Style x:Key="PlateTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ═══════════════ Decals ═══════════════

         Non-interactive marks that carry the visual language: leader lines that travel only at
         0, 45 and 90 degrees, stepped rules, barcodes, sweeping dotted arcs. All are pure
         OnRender elements with frozen pens, so they cost nothing to composite. -->

    <Style TargetType="c:Connector">
        <Setter Property="Stroke" Value="{DynamicResource HairlineStrong}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="c:StepRule">
        <Setter Property="Stroke" Value="{DynamicResource Hairline}"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="c:BarCode">
        <Setter Property="Fill" Value="{DynamicResource TextFaint}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="c:DotArc">
        <Setter Property="Stroke" Value="{DynamicResource Hairline}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="c:DataGrid">
        <Setter Property="Fill" Value="{DynamicResource TextFaint}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="c:SlantTag">
        <Setter Property="Fill" Value="{DynamicResource Accent}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="c:HazardStripes">
        <Setter Property="StripeBrush" Value="{DynamicResource TextFaint}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Section heading with a slanted accent chip and a stepped underline, rather than a bare
         word in the corner of a box. -->
    <Style x:Key="PlateHead" TargetType="HeaderedContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <c:SlantTag Grid.Column="0" Width="14" Height="11" Slant="5"
                                        VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center"/>
                            <c:StepRule Grid.Column="2" Margin="12,0,12,1" Height="8"
                                        StepAt="0.55" EndCap="Dot"
                                        VerticalAlignment="Bottom"/>
                            <ContentPresenter Grid.Column="3" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Buttons ═══════════════ -->

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <c:ChamferPanel x:Name="plate"
                                        Background="{TemplateBinding Background}"
                                        Stroke="{TemplateBinding BorderBrush}"
                                        StrokeThickness="1"
                                        Chamfer="{DynamicResource ChamferSmall}"
                                        Corners="Diagonal"
                                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PresentedText}"/>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </c:ChamferPanel>
                        <!-- Hover wash rides on top, animated via Opacity only. -->
                        <c:ChamferPanel x:Name="wash" IsHitTestVisible="False" Opacity="0"
                                        Background="{DynamicResource AccentSoft}"
                                        Chamfer="{DynamicResource ChamferSmall}"
                                        Corners="Diagonal" Padding="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Stroke" Value="{DynamicResource Accent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.20"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="content" Property="TextElement.Foreground"
                                    Value="{DynamicResource OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>

    <!-- Fill and lettering come from the palette rather than from the signal colour, because
         what reads on a filled button depends on the palette: Dark and Light letter in
         near-black on a bright fill, Night inverts to bright red on a near-black one. -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Icon-ish square button for carousel arrows and toggles. -->
    <Style x:Key="BtnSquare" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ═══════════════ Window caption buttons ═══════════════

         The glyphs are drawn as strokes rather than set in an icon font. Partly because lines
         are the language the rest of this interface is drawn in, and partly because a private-use
         codepoint that renders perfectly in one context will quietly come out as a tofu box in
         another; a Path cannot. At rest they are marks on glass with no plate of their own, so
         the corner stays quiet until you go near it. -->

    <!-- Header menu button: what the tab bar and the camera row collapse to when the window
         is too narrow to hold them. Same plate as Btn; the accent tile while its menu is open. -->
    <Style x:Key="MenuToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <c:ChamferPanel x:Name="plate"
                                    Background="{TemplateBinding Background}"
                                    Stroke="{TemplateBinding BorderBrush}"
                                    StrokeThickness="1"
                                    Chamfer="{DynamicResource ChamferSmall}"
                                    Corners="Diagonal"
                                    Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PresentedText}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </c:ChamferPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The small down-chevron after a menu button's label. Takes the button's text colour. -->
    <Style x:Key="Chevron" TargetType="Path">
        <Setter Property="Data" Value="M0,0 L4,4 L8,0"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
        <Setter Property="Margin" Value="9,1,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- The plate a header menu drops down in. Solid, since a popup has nothing behind it
         to frost. -->
    <Style x:Key="MenuPlate" TargetType="c:ChamferPanel" BasedOn="{StaticResource {x:Type c:ChamferPanel}}">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Stroke" Value="{DynamicResource HairlineStrong}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Cuts" Value="14,0,14,0"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <c:ChamferPanel x:Name="plate" Background="Transparent" Stroke="Transparent"
                                    Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                    Padding="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </c:ChamferPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background"
                                    Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="plate" Property="Stroke"
                                    Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="plate" Property="Background"
                                    Value="{DynamicResource PrimaryFill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close is the one button up here you cannot undo, so it is the one that goes red. -->
    <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <c:ChamferPanel x:Name="plate" Background="Transparent" Stroke="Transparent"
                                    Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                    Padding="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </c:ChamferPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background"
                                    Value="{DynamicResource DangerFill}"/>
                            <Setter TargetName="plate" Property="Stroke"
                                    Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Toggle (segmented) ═══════════════ -->

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <c:ChamferPanel x:Name="plate" Background="Transparent" Stroke="Transparent"
                                        Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PresentedText}"/>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </c:ChamferPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource PanelRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain radio used in settings lists. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Rectangle Stroke="{DynamicResource HairlineStrong}" StrokeThickness="1"/>
                            <Rectangle x:Name="dot" Margin="3" Fill="{DynamicResource Accent}" Opacity="0"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="dot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="dot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <!-- Templated rather than looked up inside the template, so a checkbox that sits
             somewhere other than a panel can restate its own box colour. -->
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrong}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Rectangle x:Name="box" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            <Path x:Name="tick" Stretch="Uniform" Margin="2.5"
                                  Stroke="{DynamicResource Accent}" StrokeThickness="2" Opacity="0"
                                  Data="M 0,4 L 3,7 L 9,0"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PresentedText}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A checkbox that sits on top of imagery rather than on a panel. The scrim behind it is
         dark whatever the palette is doing, so its colours are fixed instead of themed: in the
         light palette the themed foreground is near-black and disappears against that scrim. -->
    <Style x:Key="OnImageCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="#FFEDF1F5"/>
        <Setter Property="BorderBrush" Value="#C0EDF1F5"/>
    </Style>

    <!-- A number you can click into and type over.
         Deliberately carries no box, border or fill: it stands in a row of plain readouts and
         has to read as one, so the only affordances are an I-beam cursor and a hairline that
         appears under the number while it has focus. -->
    <Style x:Key="ValueEntry" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="58"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
        <Setter Property="ToolTip" Value="Click to type a value"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- Transparent fill rather than none, or only the glyphs themselves would
                         be clickable and the number would be maddening to hit. -->
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                        <Rectangle x:Name="rule" Height="1" VerticalAlignment="Bottom" Opacity="0"
                                   Fill="{DynamicResource Accent}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="rule" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Text input ═══════════════ -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <c:ChamferPanel x:Name="plate" Background="{TemplateBinding Background}"
                                        Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                                        Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                        Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </c:ChamferPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="plate" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Stroke" Value="{DynamicResource HairlineStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ ComboBox ═══════════════ -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="bar" HorizontalAlignment="Left" Width="2"
                                   Fill="{DynamicResource Accent}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <c:ChamferPanel x:Name="plate"
                                                        Background="{DynamicResource BgDeep}"
                                                        Stroke="{DynamicResource Hairline}" StrokeThickness="1"
                                                        Chamfer="{DynamicResource ChamferSmall}"
                                                        Corners="Diagonal" Padding="0"/>
                                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,11,0" Fill="{DynamicResource TextDim}"
                                              Data="M 0 0 L 4 4.5 L 8 0 Z"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="plate" Property="Stroke" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="plate" Property="Stroke" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>

                        <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <c:ChamferPanel Background="{DynamicResource PanelRaised}"
                                            Stroke="{DynamicResource HairlineStrong}" StrokeThickness="1"
                                            Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                            Margin="0,5,0,0" Padding="4"
                                            MinWidth="{Binding ActualWidth,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </c:ChamferPanel>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Slider ═══════════════ -->

    <Style TargetType="Slider">
        <Setter Property="Height" Value="18"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Rectangle Height="1" VerticalAlignment="Center"
                                   Fill="{DynamicResource Hairline}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Rectangle Height="1" VerticalAlignment="Center"
                                                           Fill="{DynamicResource Accent}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="10" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Rectangle x:Name="grip" Width="3"
                                                           Fill="{DynamicResource Accent}"/>
                                                <Rectangle x:Name="halo" Width="9" Opacity="0"
                                                           Fill="{DynamicResource AccentSoft}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="halo" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="halo" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ ProgressBar ═══════════════ -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Hairline}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Rectangle Fill="{TemplateBinding Background}"/>
                        <Rectangle x:Name="PART_Track"/>
                        <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                   Fill="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Scrollbars ═══════════════ -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="{DynamicResource Hairline}" Margin="3,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Nav tabs ═══════════════ -->

    <Style x:Key="NavTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="NavTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,3,0">
                        <c:ChamferPanel x:Name="plate" Background="Transparent" Stroke="Transparent"
                                        Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                        Padding="18,9">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </c:ChamferPanel>
                        <!-- Underline slides in on selection instead of the whole tab jumping. -->
                        <Rectangle x:Name="rule" Height="2" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="ruleScale" ScaleX="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource Panel}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ruleScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ruleScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top-level navigation. A RadioButton rather than a TabItem because the pages are
         separate elements toggled by visibility — a TabControl would also render an empty
         content area inside the header plate. -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <!-- The system's dotted focus box lands on the selected tab after any keyboard use;
             the accent tile already says which page is open. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Each tab is a small chamfered plate of its own. The selected one is the
                         accent tile with dark text — the same treatment as the segment picker —
                         and it fades in over the plate rather than snapping, so a page change
                         starts with a mechanical click rather than a colour swap. -->
                    <Grid Background="Transparent">
                        <c:ChamferPanel x:Name="hover" Background="{DynamicResource PanelRaised}"
                                        Stroke="Transparent" Chamfer="{DynamicResource ChamferSmall}"
                                        Corners="Diagonal" Opacity="0"/>
                        <c:ChamferPanel x:Name="wash" Background="{DynamicResource Accent}"
                                        Stroke="Transparent" Chamfer="{DynamicResource ChamferSmall}"
                                        Corners="Diagonal" Opacity="0"/>
                        <StackPanel Orientation="Horizontal" Margin="16,9,18,9" VerticalAlignment="Center">
                            <TextBlock x:Name="code" FontSize="9" FontWeight="DemiBold" Opacity="0.55"
                                       Margin="0,1,7,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{Binding Path=(c:Nav.Code), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PresentedText}"/>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            <Setter TargetName="code" Property="Opacity" Value="0.7"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter TargetName="hover" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Theme picker chip used on the config page. -->
    <Style x:Key="ThemeChip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <c:ChamferPanel x:Name="plate" Background="{DynamicResource PanelRaised}"
                                    Stroke="{DynamicResource Hairline}" StrokeThickness="1"
                                    Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                    Padding="14,11" Width="200">
                        <ContentPresenter/>
                    </c:ChamferPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Stroke" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="plate" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Stroke" Value="{DynamicResource HairlineStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Misc ═══════════════ -->

    <Style x:Key="Divider" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{DynamicResource HairlineSoft}"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrong}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <c:ChamferPanel Background="{TemplateBinding Background}"
                                    Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                                    Chamfer="{DynamicResource ChamferSmall}" Corners="Diagonal"
                                    Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </c:ChamferPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
