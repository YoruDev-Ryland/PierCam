<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════════════
         THEME: LIGHT — technical / industrial print

         Warm paper-white grounds, true-black hairlines and a single hot orange.
         The look leans on line weight and spacing rather than fills, which is why
         the hairlines here are near-black instead of a mid grey.
         ══════════════════════════════════════════════════════════════════════════ -->

    <sys:String x:Key="ThemeName">Light</sys:String>
    <sys:String x:Key="ThemeBlurb">Paper white, black hairlines, hot orange</sys:String>
    <sys:Boolean x:Key="ThemeIsLight">True</sys:Boolean>

    <!-- ── Surfaces ─────────────────────────────────────────────────────────── -->
    <Color x:Key="BgDeepColor">#FFDEDEDB</Color>
    <Color x:Key="BgColor">#FFE9E9E6</Color>
    <Color x:Key="PanelColor">#FFF5F5F2</Color>
    <Color x:Key="PanelRaisedColor">#FFFFFFFD</Color>

    <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelRaised" Color="{StaticResource PanelRaisedColor}"/>

    <SolidColorBrush x:Key="Glass" Color="#FFF5F5F2" Opacity="0.80"/>
    <SolidColorBrush x:Key="GlassDeep" Color="#FFE9E9E6" Opacity="0.90"/>
    <SolidColorBrush x:Key="Scrim" Color="#FFFFFFFF" Opacity="0.45"/>

    <!-- ── Lines ────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Hairline" Color="#FF1A1A18"/>
    <SolidColorBrush x:Key="HairlineSoft" Color="#FFBFBFBB"/>
    <SolidColorBrush x:Key="HairlineStrong" Color="#FF000000"/>
    <SolidColorBrush x:Key="Grid" Color="#FFD2D2CE"/>

    <!-- ── Type ─────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Text" Color="#FF0D0D0C"/>
    <SolidColorBrush x:Key="TextDim" Color="#FF56564F"/>
    <SolidColorBrush x:Key="TextFaint" Color="#FF8E8E86"/>
    <SolidColorBrush x:Key="TextInverse" Color="#FFF5F5F2"/>

    <!-- ── Signal colours ───────────────────────────────────────────────────── -->
    <Color x:Key="AccentColor">#FFF03C00</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#33F03C00"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="Signal" Color="#FF0A7D3C"/>
    <SolidColorBrush x:Key="SignalSoft" Color="#2A0A7D3C"/>
    <SolidColorBrush x:Key="Warn" Color="#FFB86A00"/>
    <SolidColorBrush x:Key="Danger" Color="#FFCC2200"/>

    <!-- ── Filled buttons ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryFill" Color="#FFF03C00"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DangerFill" Color="#FFCC2200"/>
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFFFF"/>

    <!-- ── Geometry & effect constants ──────────────────────────────────────── -->
    <sys:Double x:Key="Chamfer">12</sys:Double>
    <sys:Double x:Key="ChamferSmall">7</sys:Double>
    <sys:Double x:Key="Hairline1">1</sys:Double>
    <sys:Double x:Key="NoiseOpacity">0.035</sys:Double>
    <sys:Double x:Key="VignetteOpacity">0.18</sys:Double>

    <!-- ── Type ramp ────────────────────────────────────────────────────────── -->
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>

</ResourceDictionary>
